# Copy to .env (never commit it). All variables are optional locally.
# PORT=8787
# DATABASE_URL=postgresql://user:pass@host:5432/fightslate   # omit to use JSON files in data/runtime
# APP_URL=https://fightslate.example.com

# Required in production (24+ random characters each). No defaults exist.
# ADMIN_TOKEN=
# TOKEN_SECRET=

# Email (Resend). Emails are only sent when EMAIL_ENABLED=true; otherwise logged.
# RESEND_API_KEY=
# EMAIL_FROM=FightSlate <alerts@example.com>
# EMAIL_REPLY_TO=support@example.com
# EMAIL_ENABLED=false
# NOTIFY_MAX_PER_RUN=200

# Ingestion
# INGEST_INTERVAL_MINUTES=60
# STALE_AFTER_HOURS=36
# REVERIFY_AFTER_DAYS=7

# Optional licensed sources (see docs/DATA_SOURCES.md before enabling)
# UFCALENDAR_API_KEY=
# UFCALENDAR_ORGS=ufc,pfl
# UFCALENDAR_MIN_INTERVAL_MINUTES=1440
# BOXERBOOK_API_KEY=            # free key = non-commercial/testing only
# BOXERBOOK_MIN_INTERVAL_MINUTES=360
